# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local demo data
/data/store.json
/data/stores/
/data/users.json

.vercel
.backup

# Cursor / agent local config
/.cursor/
/.agent/
/.agents/

# local clone cache (skills are copied to .cursor/skills; re-clone to update)
/.vendor/

# one-off API dumps (may contain private task titles)
flex-tasks-fetched.json
tasks-http-dump.json
